#!/usr/bin/env sh

set -eu

RUNNER_HOME="$${CKC_RUNNER_HOME:-/opt/ckc-runner}"
OBSERVABILITY_DIR="$${RUNNER_HOME}/observability"

docker compose -f "$${OBSERVABILITY_DIR}/docker-compose.yml" up -d

printf 'Runner metrics storage: VictoriaMetrics-compatible remote_write receiver\n'
printf 'Remote write endpoint:  http://<runner-private-ip>:8428/api/v1/write\n'
printf 'Prometheus API tunnel:  http://localhost:9090\n'
printf 'Grafana:                http://localhost:3000\n'
