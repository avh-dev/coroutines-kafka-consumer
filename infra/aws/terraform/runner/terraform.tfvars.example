aws_region              = "us-east-1"
environment             = "dev"
owner                   = "local-user"
project                 = "ckc-runner"
availability_zone       = "us-east-1a"
instance_type           = "t3.small"
root_volume_size        = 20
prometheus_scrape_interval = "30s"
prometheus_evaluation_interval = "30s"
prometheus_retention_size = "2GB"
