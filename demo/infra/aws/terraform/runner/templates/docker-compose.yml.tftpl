services:
  audit:
    image: cr.fluentbit.io/fluent/fluent-bit:4.2.3
    container_name: audit
    restart: unless-stopped
    command: ["-c", "/fluent-bit/etc/fluent-bit.yaml"]
    ports:
      - "5170:5170"
    volumes:
      - /opt/ckc-runner/config/fluent-bit.yaml:/fluent-bit/etc/fluent-bit.yaml:ro
      - /opt/ckc-runner/audit:/audit

  prometheus:
    image: victoriametrics/victoria-metrics:v1.102.1
    container_name: prometheus
    restart: unless-stopped
    command:
      - -storageDataPath=/victoria-metrics-data
      - -retentionPeriod=1
      - -httpListenAddr=:9090
    ports:
      - "127.0.0.1:9090:9090"
      - "8428:9090"
    volumes:
      - /opt/ckc-runner/prometheus:/victoria-metrics-data

  grafana:
    image: grafana/grafana:11.6.0
    container_name: grafana
    restart: unless-stopped
    ports:
      - "127.0.0.1:3000:3000"
    environment:
      GF_SECURITY_ADMIN_USER: admin
      GF_SECURITY_ADMIN_PASSWORD: admin
    volumes:
      - /opt/ckc-runner/grafana:/var/lib/grafana
      - /opt/ckc-runner/observability/grafana/provisioning:/etc/grafana/provisioning:ro
      - /opt/ckc-runner/observability/grafana/dashboards:/var/lib/grafana/dashboards:ro
    depends_on:
      - prometheus
