#!/bin/bash
set -euxo pipefail

dnf update -y
dnf install -y docker git unzip tar gzip shadow-utils dnf-plugins-core wireshark-cli

systemctl enable --now docker
usermod -aG docker ec2-user

mkdir -p /opt/ckc-runner/prometheus
mkdir -p /opt/ckc-runner/loki
mkdir -p /opt/ckc-runner/grafana
mkdir -p /opt/ckc-runner/audit
mkdir -p /opt/ckc-runner/reports
mkdir -p /opt/ckc-runner/config
mkdir -p /opt/ckc-runner/bin
mkdir -p /opt/ckc-runner/observability/grafana/provisioning/dashboards
mkdir -p /opt/ckc-runner/observability/grafana/provisioning/datasources
mkdir -p /opt/ckc-runner/observability/grafana/dashboards
chown -R ec2-user:ec2-user /opt/ckc-runner

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

rpm --import https://rpm.releases.hashicorp.com/gpg
dnf config-manager --add-repo https://rpm.releases.hashicorp.com/AmazonLinux/hashicorp.repo
dnf install -y terraform

curl -fsSL "https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3" -o /tmp/get_helm.sh
chmod +x /tmp/get_helm.sh
/tmp/get_helm.sh

curl -fsSL "https://dl.k8s.io/release/v1.33.0/bin/linux/amd64/kubectl" -o /usr/local/bin/kubectl
chmod +x /usr/local/bin/kubectl

mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64" -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

cat > /etc/profile.d/ckc-runner.sh <<'EOF'
export CKC_RUNNER_HOME=/opt/ckc-runner
EOF

cat > /opt/ckc-runner/observability/docker-compose.yml <<'EOF'
${docker_compose}
EOF

cat > /opt/ckc-runner/config/prometheus.yml <<'EOF'
${default_prometheus_config}
EOF

cat > /opt/ckc-runner/config/fluent-bit.yaml <<'EOF'
service:
  flush: 1
  daemon: off
  log_level: info
  http_server: on
  http_listen: 0.0.0.0
  http_port: 2020
  health_check: on

pipeline:
  inputs:
    - name: tcp
      listen: 0.0.0.0
      port: 5170
      chunk_size: 256
      buffer_size: 1024
      format: json

  outputs:
    - name: file
      match: '*'
      path: /audit
      file: audit.log
      format: template
      template: '{message}'
EOF

cat > /opt/ckc-runner/observability/grafana/provisioning/dashboards/ckc.yml <<'EOF'
${grafana_dashboard_provider_config}
EOF

cat > /opt/ckc-runner/observability/grafana/provisioning/datasources/prometheus.yml <<'EOF'
${grafana_prometheus_datasource_config}
EOF

cat > /opt/ckc-runner/observability/grafana/provisioning/datasources/loki.yml <<'EOF'
${grafana_loki_datasource_config}
EOF

cat > /opt/ckc-runner/observability/grafana/dashboards/ckc-overview.json <<'EOF'
${grafana_ckc_overview_dashboard}
EOF

cat > /opt/ckc-runner/bin/configure-observability.sh <<'EOF'
${configure_observability_script_content}
EOF

chmod +x /opt/ckc-runner/bin/configure-observability.sh
chown 65534:65534 /opt/ckc-runner/prometheus
chown 10001:10001 /opt/ckc-runner/loki
chown 472:472 /opt/ckc-runner/grafana
chown -R 1000:1000 /opt/ckc-runner/audit

cat > /etc/systemd/system/ckc-runner-observability.service <<'EOF'
[Unit]
Description=CKC runner observability stack
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/ckc-runner/observability
ExecStart=/usr/bin/docker compose -f /opt/ckc-runner/observability/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/ckc-runner/observability/docker-compose.yml down

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now ckc-runner-observability.service
